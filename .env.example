# Local smoke test: no paid model calls. NOT semantic RAG quality.
RAG_ENVIRONMENT=development
RAG_PROVIDER=offline
RAG_API_KEY=local-demo-service-key-change-before-deploy
RAG_GROQ_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_GENERATION_MODEL=openai/gpt-oss-120b
RAG_DIMENSIONS=384
RAG_DATA_DIR=data
RAG_INDEX_DIR=storage
RAG_BOOTSTRAP=true
RAG_MIN_SIMILARITY=0.25
RAG_TOP_K=4
RAG_TIMEOUT_SECONDS=20
RAG_REQUESTS_PER_MINUTE=30
RAG_MAX_CONCURRENCY=4
# Railway: RAG_ENVIRONMENT=production, RAG_PROVIDER=groq, RAG_INDEX_DIR=/data/index
# PORT is supplied by Railway. All secrets belong here or Railway Variables, never frontend env.
RAG_MODEL_CACHE_DIR=storage/models
